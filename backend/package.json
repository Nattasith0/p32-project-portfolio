{
  "name": "p32-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the P32 project management system",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test",
    "db:check": "node --env-file=.env scripts/check-database.js",
    "db:check:migrations": "node --env-file=.env.migrations scripts/check-database.js",
    "db:migrate:check": "node --env-file=.env.migrations scripts/migrate.js check",
    "db:migrate:create": "node-pg-migrate create",
    "db:migrate:up": "node --env-file=.env.migrations scripts/migrate.js up",
    "db:seed:check": "node --env-file=.env.migrations --env-file=.env.seed scripts/seed-development.js check",
    "db:seed": "node --env-file=.env.migrations --env-file=.env.seed scripts/seed-development.js seed",
    "db:check:sessions": "node --env-file=.env scripts/check-session-repository.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "jose": "6.2.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "node-pg-migrate": "9.0.0"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "14.0.3"
    }
  }
}
